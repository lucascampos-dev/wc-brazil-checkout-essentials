{
    "name": "lucasthobias/wc-brazil-checkout-essentials",
    "description": "WooCommerce plugin: CPF/CNPJ with check-digit validation, Brazilian CEP and phone validation, and minimum order amount per state (UF).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "woocommerce", "brazil", "cpf", "cnpj", "cep", "checkout", "hpos"],
    "homepage": "https://github.com/lucasthobias/wc-brazil-checkout-essentials",
    "authors": [
        {
            "name": "Lucas Campos",
            "homepage": "https://github.com/lucasthobias",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BrazilCheckoutEssentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrazilCheckoutEssentials\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "scripts-descriptions": {
        "lint": "Syntax-check every PHP file with php -l.",
        "test": "Run the WordPress-free unit test suite.",
        "phpcs": "Check coding standards (WPCS + PHPCompatibility).",
        "phpcbf": "Auto-fix coding standard violations."
    }
}
